<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:text="Tres · Prioridades" android:textSize="18sp" android:textStyle="bold" android:textColor="#F5F4F0" />
        <TextView android:id="@+id/widget_voice" android:layout_width="72dp" android:layout_height="match_parent" android:gravity="center" android:text="Dictar" android:textColor="#F5F4F0" android:contentDescription="Crear nota por voz" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
        <TextView android:id="@+id/check_one" android:layout_width="48dp" android:layout_height="match_parent" android:gravity="center" android:text="○" android:textColor="#F5F4F0" android:textSize="26sp" />
        <TextView android:id="@+id/note_one" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:maxLines="2" android:ellipsize="end" android:textColor="#F5F4F0" android:textSize="15sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
        <TextView android:id="@+id/check_two" android:layout_width="48dp" android:layout_height="match_parent" android:gravity="center" android:text="○" android:textColor="#F5F4F0" android:textSize="26sp" />
        <TextView android:id="@+id/note_two" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:maxLines="2" android:ellipsize="end" android:textColor="#F5F4F0" android:textSize="15sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
        <TextView android:id="@+id/check_three" android:layout_width="48dp" android:layout_height="match_parent" android:gravity="center" android:text="○" android:textColor="#F5F4F0" android:textSize="26sp" />
        <TextView android:id="@+id/note_three" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:maxLines="2" android:ellipsize="end" android:textColor="#F5F4F0" android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
